  {
    "id": "fn_line",
    "type": "function",
    "z": "tab_smartbin",
    "name": "To line protocol",
    "func": "const p = msg.payload;\nif (typeof p !== \"object\" || typeof p.fill !== \"number\") {\n    node.warn(\"Bad payload: \" + JSON.stringify(p));\n    return null;\n}\nconst bin = msg.topic.split(\"/\")[1] || \"unknown\";\nconst status = String(p.status || \"\").replace(/\"/g, \"\");\nnode.status({fill: p.fill >= 80 ? \"red\" : p.fill >= 50 ? \"yellow\" : \"green\",\n             shape: \"dot\", text: bin + \": \" + p.fill + \"% \" + status});\n// InfluxDB line protocol (timestamp added by InfluxDB on arrival)\nmsg.payload = `bin_level,bin=${bin} fill=${p.fill},distance=${Number(p.distance)},status=\"${status}\"`;\nmsg.headers = {\n    \"Authorization\": \"Token smartbin-token-123\",\n    \"Content-Type\": \"text/plain; charset=utf-8\"\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 120,
    "wires": [
      [
        "http_influx"
      ]
    ]
  },
  {
    "id": "http_influx",
    "type": "http request",
    "z": "tab_smartbin",
    "name": "Write to InfluxDB",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://influxdb:8086/api/v2/write?org=smartbin&bucket=bin_data&precision=ns",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
